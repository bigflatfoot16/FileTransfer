{
  "name": "lockdown-ide",
  "private": true,
  "version": "0.1.0",
  "description": "A locked-down IDE with an internal-only clipboard and a sandboxed live preview.",
  "type": "module",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "start": "electron .",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.node.json --noEmit",
    "test": "vitest run",
    "test:e2e": "vite build --mode e2e && playwright test"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "electron": "^44.4.5",
    "monaco-editor": "^0.57.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vite-plugin-electron": "^1.1.2",
    "vitest": "^5.0.2"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
