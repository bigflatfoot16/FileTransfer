{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SwiftCopy",
  "version": "0.1.0",
  "identifier": "com.swiftcopy.app",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "SwiftCopy",
        "width": 1100,
        "height": 720,
        "minWidth": 780,
        "minHeight": 500,
        "resizable": true,
        "decorations": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {}
}
